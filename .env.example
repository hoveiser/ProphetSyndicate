# ProphetSyndicate environment
# Copy to .env and fill in the two values below. Never commit the real .env.

# 0x prefixed private key of the studionet deployer account. Never printed by any script.
GENLAYER_PRIVATE_KEY=

# GitHub personal access token with repo + workflow scope, used by scripts/publish_github.py only.
GITHUB_TOKEN=

# Optional: the deployed intelligent contract the frontend should talk to.
VITE_CONTRACT_ADDRESS=
